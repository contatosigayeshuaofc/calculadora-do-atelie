{
  "name": "calculadora-do-atelie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "node scripts/with-cloudflare-env.mjs opennextjs-cloudflare build",
    "cf:preview": "node scripts/with-cloudflare-env.mjs opennextjs-cloudflare build && node scripts/with-cloudflare-env.mjs opennextjs-cloudflare preview",
    "cf:deploy": "node scripts/with-cloudflare-env.mjs opennextjs-cloudflare build && node scripts/with-cloudflare-env.mjs opennextjs-cloudflare deploy",
    "cf:upload": "node scripts/with-cloudflare-env.mjs opennextjs-cloudflare build && node scripts/with-cloudflare-env.mjs opennextjs-cloudflare upload",
    "cf:typegen": "node scripts/with-cloudflare-env.mjs wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.mjs",
    "supabase:check": "node scripts/check-supabase-activation.mjs",
    "supabase:version": "supabase --version",
    "supabase:activate": "node scripts/check-supabase-activation.mjs && node scripts/apply-supabase-migrations.mjs",
    "pilot:check": "node scripts/pilot-check.mjs",
    "admin:create": "node scripts/create-admin-user.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.18.1",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "9.39.2",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "supabase": "^2.109.1",
    "tailwindcss": "latest",
    "typescript": "6.0.3",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
